FROM rockylinux:9

# PostgreSQL version to install from the PGDG repository.
# Packages are resolved by name, so the same definition works on every
# architecture supported by PGDG (x86_64, aarch64).
ARG PG_MAJOR=18
ARG PG_VERSION=18.7

ENV PGDATA /var/lib/pgsql/data/userdata
ENV PGUSER postgres
ENV POSTGRESQL_USER=${POSTGRESQL_USER}
ENV POSTGRESQL_PASSWORD=${POSTGRESQL_PASSWORD}
ENV POSTGRESQL_DATABASE=${POSTGRESQL_DATABASE}
ENV POSTGRESQL_ADMIN_PASSWORD=${POSTGRESQL_ADMIN_PASSWORD}
ENV PATH $PATH:$PGDATA

# Install PostgreSQL (architecture-agnostic)
RUN set -eux; \
    ARCH="$(uname -m)"; \
    case "${ARCH}" in \
      x86_64|aarch64) ;; \
      *) echo "Unsupported architecture: ${ARCH}" >&2; exit 1 ;; \
    esac; \
    dnf -qy module disable postgresql; \
    dnf update -y; \
    dnf install -y "https://download.postgresql.org/pub/repos/yum/reporpms/EL-9-${ARCH}/pgdg-redhat-repo-latest.noarch.rpm"; \
    dnf install -y \
      --disablerepo='pgdg*' --enablerepo="pgdg${PG_MAJOR}" --enablerepo='pgdg-common' \
      langpacks-en glibc-all-langpacks \
      "postgresql${PG_MAJOR}-${PG_VERSION}" \
      "postgresql${PG_MAJOR}-libs-${PG_VERSION}" \
      "postgresql${PG_MAJOR}-server-${PG_VERSION}" \
      "postgresql${PG_MAJOR}-contrib-${PG_VERSION}"; \
    dnf clean all; \
    rm -rf /var/cache/dnf; \
    "/usr/pgsql-${PG_MAJOR}/bin/postgres" --version | grep -F " ${PG_VERSION}"

COPY docker-entrypoint.sh /
COPY check-container /usr/libexec/
RUN chmod a+xr /docker-entrypoint.sh \
 && usermod -a -G root postgres \
 && chgrp -R root "/var/lib/pgsql/" \
 && chmod g+rwX "/var/lib/pgsql/" \
 && chgrp -R root "/var/run/postgresql" \
 && chmod g+rw "/var/run/postgresql" \
 && chmod ug+x "/usr/libexec/check-container" \
  ;

USER 26

ENTRYPOINT ["/docker-entrypoint.sh"]

STOPSIGNAL SIGINT

EXPOSE 5432

CMD ["/usr/pgsql-18/bin/postgres"]
